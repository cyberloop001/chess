# Leave empty for local dev (Vite proxies /api and /ws to port 8000).
# For GitHub Pages, set to your public FastAPI origin (no trailing slash).
# VITE_API_URL=https://your-api.onrender.com

# Optional: override WebSocket origin (defaults to wss:// same host as VITE_API_URL)
# VITE_WS_URL=wss://your-api.onrender.com
